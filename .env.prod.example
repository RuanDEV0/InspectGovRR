# Copie para .env.prod e substitua todos os valores secretos.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em HTTPS, informe a origem completa do domínio público, por exemplo https://dados.exemplo.org.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Habilite apenas quando um proxy confiável definir X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

DB_NAME=inspectgovrr
DB_USER=inspectgovrr
DB_PASSWORD=replace-with-a-long-random-db-password
DB_HOST=db
DB_PORT=5432
WEB_HOST_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1

FIPLAN_AUTO_SYNC_ENABLED=False
FIPLAN_SYNC_INTERVAL_MINUTES=1440
FIPLAN_SYNC_YEAR=2026
FIPLAN_NATURE_CODE=33903900
FIPLAN_SYNC_DIARIAS_ENABLED=False
# Receita, remunerações e contratos ligam automaticamente quando há credenciais.
# FIPLAN_REVENUE_AUTO_SYNC_ENABLED=False
# FIPLAN_PAYROLL_AUTO_SYNC_ENABLED=False
# FIPLAN_CONTRACTS_AUTO_SYNC_ENABLED=False
