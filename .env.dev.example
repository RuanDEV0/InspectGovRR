# Copie este arquivo para .env e ajuste as credenciais antes de iniciar.
# Configuracao Django (somente desenvolvimento).
DJANGO_SECRET_KEY=django-insecure-change-this-local-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# PostgreSQL. Para execucao nativa, DB_HOST aponta para o banco local.
# No Compose, DB_HOST e DB_PORT sao definidos para o servico "db".
DB_NAME=inspectgovrr
DB_USER=inspectgovrr
DB_PASSWORD=change-this-local-db-password
DB_HOST=localhost
DB_PORT=5432
# Deixe vazio para usar DB_*; uma URL definida tem prioridade no Django.
DATABASE_URL=
# Porta publicada pelo Compose no computador; altere se 5432 estiver ocupada.
DB_HOST_PORT=5432
# Porta do Django publicada pelo Compose no computador.
WEB_HOST_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_MIGRATE_ON_STARTUP=False
FIPLAN_INITIAL_LOAD_ENABLED=False

# Credenciais da API de transparencia de Roraima para os comandos de coleta.
FIPLAN_USERNAME=
FIPLAN_PASSWORD=

# Sincronizacao automatica: False desativa, True executa ao iniciar e depois
# a cada intervalo configurado. Exemplo: 60 = 1 hora; 1440 = 24 horas.
FIPLAN_AUTO_SYNC_ENABLED=False
FIPLAN_SYNC_INTERVAL_MINUTES=1440
FIPLAN_SYNC_YEAR=2026
FIPLAN_NATURE_CODE=33903900
# O contrato de identificacao de cada diaria precisa ser confirmado na API.
FIPLAN_SYNC_DIARIAS_ENABLED=False
# Receita arrecadada: atualização diária independente da sincronização geral.
# Com credenciais configuradas, fica ativa por padrão. Defina False para pausar.
# FIPLAN_REVENUE_AUTO_SYNC_ENABLED=False
# Remunerações: ranking e detalhes atualizados diariamente, independente da coleta geral.
# Com credenciais configuradas, fica ativa por padrão. Defina False para pausar.
# FIPLAN_PAYROLL_AUTO_SYNC_ENABLED=False
# Contratos: lista do ano agregada por fornecedor e por órgão, atualizada diariamente.
# Com credenciais configuradas, fica ativa por padrão. Defina False para pausar.
# FIPLAN_CONTRACTS_AUTO_SYNC_ENABLED=False
